{
  "name": "pms-fe",
  "private": true,
  "scripts": {
    "dev:pms-admin": "turbo run dev --filter=pms-admin",
    "build:pms-admin": "turbo run build --filter=pms-admin",
    "lint:pms-admin": "turbo run lint --filter=pms-admin",
    "dev:pms-tenant": "turbo run dev --filter=pms-tenant",
    "build:pms-tenant": "turbo run build --filter=pms-tenant",
    "lint:pms-tenant": "turbo run lint --filter=pms-tenant",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@pms/tsconfig": "workspace:*",
    "prettier": "^3.5.3",
    "turbo": "^2.5.0",
    "typescript": "5.8.3"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
